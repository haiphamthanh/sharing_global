import time
from .openai_client import responses_call, extract_text_or_json
from .utils import safe_json_loads

def plan(user_prompt: str, planner_template: str, time_budget_s: float, max_steps: int, timeout_s: float):
    system = "Bạn là Planner: luôn tôn trọng thời gian và độ chính xác."
    planner_user = planner_template.format(
        time_budget_s=time_budget_s,
        user_prompt=user_prompt,
        max_steps=max_steps
    )
    # Bắt buộc ép JSON để parse nhanh và ổn định (structured outputs).  [oai_citation:4‡OpenAI Platform](https://platform.openai.com/docs/guides/structured-outputs?utm_source=chatgpt.com)
    res = responses_call(
        system_prompt=system,
        user_prompt=planner_user,
        timeout_s=timeout_s,
        response_format={"type": "json_object"}
    )
    text = extract_text_or_json(res)
    obj = safe_json_loads(text) or {"steps": [], "abort_if": [], "cut_policy": ""}
    # sanitize
    steps = obj.get("steps", [])
    return {
        "steps": steps[:max_steps],
        "abort_if": obj.get("abort_if", []),
        "cut_policy": obj.get("cut_policy", "")
    }

