import json
import requests
from typing import Optional, Dict, Any, List
from .config import OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, MAX_OUTPUT_TOKENS, TEMPERATURE

# Responses API (tài liệu tham chiếu): https://platform.openai.com/docs/api-reference/responses
# Sử dụng input dạng "messages" (role + content) để tương thích tư duy chat.  [oai_citation:2‡OpenAI Platform](https://platform.openai.com/docs/api-reference/responses?utm_source=chatgpt.com)

_DEFAULT_HEADERS = {
    "Authorization": f"Bearer {OPENAI_API_KEY}",
    "Content-Type": "application/json",
}

def responses_call(
    system_prompt: str,
    user_prompt: str,
    timeout_s: float,
    response_format: Optional[Dict[str, Any]] = None,
    extra_messages: Optional[List[Dict[str, Any]]] = None,
) -> Dict[str, Any]:
    """
    Gọi OpenAI Responses API bằng REST.
    Trả về object JSON của full phản hồi.
    """
    url = f"{OPENAI_BASE_URL}/v1/responses"

    # Build messages theo Responses API
    messages = []
    if system_prompt:
        messages.append({"role": "system", "content": [{"type": "text", "text": system_prompt}]})
    if extra_messages:
        messages.extend(extra_messages)
    messages.append({"role": "user", "content": [{"type": "text", "text": user_prompt}]})

    payload: Dict[str, Any] = {
        "model": OPENAI_MODEL,
        "input": messages,
        "temperature": TEMPERATURE,
        "max_output_tokens": MAX_OUTPUT_TOKENS,
    }
    if response_format:
        payload["response_format"] = response_format  # e.g. {"type":"json_object"} or {"type":"json_schema", ...}

    resp = requests.post(url, headers=_DEFAULT_HEADERS, json=payload, timeout=timeout_s)
    resp.raise_for_status()
    return resp.json()

def extract_text_or_json(response: Dict[str, Any]) -> str:
    """
    Responses API trả về output trong 'output_text' tiện lợi (tuỳ thời điểm).
    Nếu không có, lấy từ output[0].content[0].text.
    Docs tổng quát: https://platform.openai.com/docs/api-reference/responses  [oai_citation:3‡OpenAI Platform](https://platform.openai.com/docs/api-reference/responses?utm_source=chatgpt.com)
    """
    if "output_text" in response and response["output_text"]:
        return response["output_text"]
    # Fallback: duyệt cấu trúc output theo spec
    try:
        output = response.get("output", [])
        if output and "content" in output[0]:
            parts = output[0]["content"]
            if parts and parts[0].get("type") == "output_text":
                return parts[0].get("text", "")
            if parts and parts[0].get("type") == "text":
                return parts[0].get("text", "")
        # Một số bản trả về "message"
        message = response.get("message", {})
        if message:
            content = message.get("content", [])
            if content and content[0].get("type") == "output_text":
                return content[0].get("text", "")
            if content and content[0].get("type") == "text":
                return content[0].get("text", "")
    except Exception:
        pass
    return ""

