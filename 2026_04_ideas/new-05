10. response_loader.py

import json
from pathlib import Path
MOCK_DIR = Path("./mocks")
def load_mock(api_name, scenario):
    path = MOCK_DIR / api_name / f"{scenario}.json"
    if not path.exists():
        return None
    with open(path, "r") as f:
        return json.load(f)

⸻

11. scenario_manager.py

import json
with open("device_registry.json") as f:
    DEVICE_REGISTRY = json.load(f)
def get_scenario(device_name, api_name):
    device = DEVICE_REGISTRY.get(device_name)
    if not device:
        return None
    return device.get(api_name)

⸻

12. main.py

from mitmproxy import http
import json
from scenario_manager import get_scenario
from response_loader import load_mock
def request(flow: http.HTTPFlow):
    host = flow.request.host
    path = flow.request.path
    # identify device
    device_name = flow.request.headers.get(
        "X-Device-Name",
        "unknown"
    )
    api_name = resolve_api(path)
    scenario = get_scenario(
        device_name,
        api_name
    )
    if not scenario:
        return
    mock = load_mock(api_name, scenario)
    if not mock:
        return
    flow.response = http.Response.make(
        200,
        json.dumps(mock),
        {
            "Content-Type": "application/json"
        }
    )
def resolve_api(path):
    if "/profile" in path:
        return "profile"
    if "/feed" in path:
        return "feed"
    return None

