def merge_results(step_results: dict):
    """Ghép kết quả từ các step thành một đối tượng gọn gàng."""
    ordered = []
    for sid, payload in step_results.items():
        ordered.append({"id": sid, **payload})
    return {"steps": ordered}

agent/controller.py

import time
from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
from collections import defaultdict

from .config import TIME_BUDGET_S, MAX_WORKERS
from .planner import plan
from .executor import exec_step
from .verifier import verify
from .merger import merge_results

def topo_layers(steps):
    """Chuyển steps thành các 'lớp' theo deps (để có thể chạy song song)."""
    id2step = {s["id"]: s for s in steps}
    deps = {s["id"]: set(s.get("deps", [])) for s in steps}
    layers = []
    remaining = set(id2step)

    while remaining:
        ready = [id2step[i] for i in list(remaining) if not deps[i]]
        if not ready:
            # vòng phụ thuộc → phá vòng bằng cách pick 1
            any_id = next(iter(remaining))
            ready = [id2step[any_id]]
        layers.append(ready)
        for r in ready:
            remaining.remove(r["id"])
        for dset in deps.values():
            dset.difference_update({r["id"] for r in ready})
    return layers

def run_agent(
    user_prompt: str,
    planner_template: str,
    executor_template: str,
    verifier_template: str,
    max_steps: int = 6
):
    t0 = time.time()

    # 1) Lập kế hoạch
    plan_timeout = min(4.0, TIME_BUDGET_S * 0.2)
    p = plan(user_prompt, planner_template, TIME_BUDGET_S, max_steps, plan_timeout)
    steps = p["steps"]

    if not steps:
        return {"error": "Không tạo được kế hoạch."}

    # 2) Thực thi có kiểm soát thời gian
    results = {}
    cut_off = TIME_BUDGET_S * 0.8

    layers = topo_layers(steps)
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        for layer in layers:
            futures = {}
            for s in layer:
                elapsed = time.time() - t0
                # Nếu gần hết giờ -> bỏ bước priority=low
                if elapsed > cut_off and s.get("priority", "normal") == "low":
                    results[s["id"]] = {"skipped": True, "reason": "time_budget"}
                    continue
                # đặt timeout per-step < ETA *0.9, và tối đa 6s
                step_timeout = max(0.5, min(6.0, (s.get("eta_ms", 2000) / 1000.0) * 0.9))
                futures[pool.submit(exec_step, s, executor_template, step_timeout)] = s["id"]

            while futures:
                done, _ = wait(futures, timeout=0.2, return_when=FIRST_COMPLETED)
                for fut in done:
                    sid = futures.pop(fut)
                    try:
                        results[sid] = fut.result()
                    except Exception as e:
                        results[sid] = {"id": sid, "error": str(e), "confidence": 0.0}

                # hard-stop nếu vượt ngân sách
                if time.time() - t0 > TIME_BUDGET_S:
                    break
            if time.time() - t0 > TIME_BUDGET_S:
                break

    merged = merge_results(results)

    # 3) Verifier nhẹ (nếu còn thời gian ~10% ngân sách)
    elapsed = time.time() - t0
    verify_budget = TIME_BUDGET_S - elapsed - 1.0  # chừa 1s buffer
    if verify_budget > 1.0:
        try:
            v = verify(merged, verifier_template, timeout_s=min(3.0, verify_budget))
            merged["verification"] = v
        except Exception as e:
            merged["verification"] = {"valid": True, "notes": f"Verifier error: {e}"}

    merged["elapsed_s"] = round(time.time() - t0, 3)
    merged["time_budget_s"] = TIME_BUDGET_S
    merged["cut_policy"] = p.get("cut_policy", "")
    return merged

